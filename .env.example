# =====================================================
# LinkedIn Helper Backend - Environment Configuration
# Copy this file as .env and fill in your values
# =====================================================

PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/linkedin_helper_backend

JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=*

# LinkedIn Developer App (OAuth 2.0)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://127.0.0.1:48291/callback
